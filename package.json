{
  "name": "eli-styles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --target=node20 --loader:.css=empty --external:jsdom --outfile=scripts/.smoke.cjs --log-level=warning && node scripts/.smoke.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
